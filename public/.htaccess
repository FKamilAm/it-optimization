# Айти-Оптимизация — статический сайт (Next.js export) для хостинга reg.ru (Apache).
# Если хостинг на nginx, этот файл просто игнорируется — вреда не будет.
#
# ВНИМАНИЕ: сейчас так и есть. PHP для аккаунта запрещён (галочка в ISPmanager
# серая: «Данному пользователю запрещено использовать PHP»), поэтому сайт
# отдаёт напрямую nginx и этот файл не читается — на несуществующих адресах
# стоит заглушка nginx. Правила ниже заработают в ту минуту, когда reg.ru
# включит для сайта Apache; либо они же пропишут в nginx error_page.

# Корректные MIME-типы для современных форматов
AddType image/webp .webp
AddType image/avif .avif

# Сжатие текстовых ресурсов
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>

# Кэширование статики (хэшированные ассеты можно кэшировать надолго)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# Страница «не найдено». Файл один на все языки: язык он берёт из адреса сам.
ErrorDocument 404 /404.html

# Страница «доступ закрыт». У неё три языковые версии, и отказ на /en/… или
# /es/… должен показывать свою. <If> есть только в Apache 2.4, а неизвестная
# директива в .htaccess роняет весь сайт с ошибкой 500, поэтому языковые
# правила — под проверкой версии: без неё останется русская 403, но не 500.
ErrorDocument 403 /403/index.html
<IfModule mod_version.c>
  <IfVersion >= 2.4>
    <If "%{REQUEST_URI} =~ m#^/en(/|$)#">
      ErrorDocument 403 /en/403/index.html
    </If>
    <If "%{REQUEST_URI} =~ m#^/es(/|$)#">
      ErrorDocument 403 /es/403/index.html
    </If>
  </IfVersion>
</IfModule>
