# CRM — одностраничное приложение: маршруты вроде /leads/42 существуют только в
# браузере, на диске такого файла нет. Без этого правила прямая ссылка и F5 на
# любом разделе дают 404 от Apache.
#
# ВНИМАНИЕ: на текущем хостинге этот файл не работает. PHP для аккаунта
# отключён, поэтому сайт отдаётся напрямую nginx, а он .htaccess не читает.
# Поэтому приложение переведено на маршрутизацию через решётку (см. src/app.tsx).
# Файл оставлен намеренно: он понадобится в ту же минуту, когда сайт начнёт
# обслуживаться Apache, — тогда можно вернуть обычные адреса.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Реально существующие файлы и папки отдаём как есть.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Всё остальное — приложению.
  RewriteRule . /index.html [L]
</IfModule>

# Хэшированные ассеты Vite неизменяемы, index.html — нет.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header set X-Robots-Tag "noindex, nofollow"
</IfModule>
