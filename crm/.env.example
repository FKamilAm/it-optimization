# Скопировать в crm/.env.local и заполнить. В репозиторий .env* не коммитится.

# Адрес API. Он же обслуживает панель кейсов на сайте.
# В проде: https://api.it-optimization.ru
VITE_API_URL=http://localhost:4000

# Имя бота уведомлений — из него собирается ссылка t.me на экране настроек.
VITE_BOT_USERNAME=it_optimization_bot
