# Боевые переменные. На сервере: cp .env.production.example .env и заполнить.
# Этот файл — единственный источник секретов сервиса, в репозиторий не попадает.
#
# Пароли и токен генерируются один раз при развёртывании:
#   openssl rand -base64 24     ← пароль базы

# --- База -------------------------------------------------------------------
# Из этих трёх значений docker-compose.prod.yml собирает и саму базу, и
# DATABASE_URL для API — руками строку подключения писать не нужно.
POSTGRES_USER=itopt
POSTGRES_PASSWORD=ЗАМЕНИ_НА_СЛУЧАЙНЫЙ_ПАРОЛЬ
POSTGRES_DB=itopt

# --- Домен и сертификат -----------------------------------------------------
# A-запись этого домена должна указывать на IP сервера ДО первого запуска:
# Caddy проверяет владение доменом через порт 80.
API_DOMAIN=api.it-optimization.ru
# Почта для Let's Encrypt: туда придёт письмо, если сертификат перестанет
# продлеваться. Указывай рабочую.
ACME_EMAIL=info@itoptimizations.ru

# --- Сервис -----------------------------------------------------------------
NODE_ENV=production
PORT=4000

# Точные адреса сайта и CRM через запятую: браузер не примет ответ с
# credentials, если в CORS стоит «*» или домен отличается хоть одним символом.
WEB_ORIGIN=https://it-optimization.ru,https://crm.it-optimization.ru

# Кука уходит только по HTTPS. С false вход по HTTP будет «работать», а сессия
# поедет открытым текстом — в проде всегда true.
COOKIE_SECURE=true
# API живёт на поддомене, поэтому кука выписывается на общий домен.
COOKIE_DOMAIN=.it-optimization.ru
SESSION_TTL_DAYS=14

# --- Файлы ------------------------------------------------------------------
# Внутри контейнера это том uploads (см. docker-compose.prod.yml) — не менять.
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_BYTES=15728640

# --- Напоминания в телеграме ------------------------------------------------
# Токен от @BotFather. Опрашивать обновления может только один процесс на бота,
# поэтому при нескольких репликах API бота надо выносить отдельно.
TELEGRAM_BOT_TOKEN=
# Общий чат для новых лидов (у групп id отрицательный, с -100). Пусто — шлём
# всем, кто подключил бота лично.
TELEGRAM_TEAM_CHAT_ID=
# Адрес Bot API. Менять, только если до api.telegram.org нет прямого хода —
# некоторые хостеры режут именно его. Тогда сюда прописывается ретранслятор.
TELEGRAM_API_BASE=https://api.telegram.org
DIGEST_TIME=09:00
TIMEZONE=Europe/Moscow

# --- Публикация -------------------------------------------------------------
# Fine-grained PAT: только репозиторий сайта, Contents: read and write.
# Живёт здесь и в браузер не попадает — в этом смысл перехода на бэкенд.
#
# Оставь пустым при первом развёртывании: публикация будет работать вхолостую,
# и можно спокойно проверить вход и редактирование, ничего не закоммитив.
GITHUB_TOKEN=
GITHUB_OWNER=FKamilAm
GITHUB_REPO=it-optimization
GITHUB_BRANCH=main
