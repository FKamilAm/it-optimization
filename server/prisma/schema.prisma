// Схема базы сайта it-optimization.ru. См. docs/backend.md.
// Форма таблицы `cases` намеренно совпадает с content/cases.json, поэтому
// перенос данных — это сид, а не переделка модели.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- Портфолио

enum ContentStatus {
  draft
  published
}

model Case {
  id     String        @id @default(uuid()) @db.Uuid
  /// Участвует в именах файлов и в ссылках со страниц услуг, поэтому живёт
  /// отдельно от id и переживает переименование заголовка.
  slug   String        @unique
  status ContentStatus @default(published)

  title       String
  description String
  quote       String
  /// Раньше было одной строкой «A · B · C»; массив — нормальная форма.
  tags        String[]
  /// Ключи услуг (SERVICE_PAGES), на страницах которых показывается кейс и
  /// по которым он фильтруется. Кейс может относиться к нескольким сразу.
  services    String[]

  /// Порядок на сайте. Первые HOME_CASE_COUNT попадают на главную.
  position Int

  assets  CaseAsset[]
  /// Проект, из которого вырос кейс. Заполняется, когда закрытый проект
  /// публикуют на сайте; у кейсов, заведённых руками, связи нет.
  project Project?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  /// Мягкое удаление: кейс исчезает с сайта, но остаётся для истории.
  deletedAt DateTime? @map("deleted_at")

  @@index([status, position])
  @@map("cases")
}

enum AssetSlot {
  cover
  detail
  detail_mobile
}

/// Картинки кейса. Отдельной таблицей: ассет переживает смену slug, а по хэшу
/// видно, что перезаливать его не нужно.
model CaseAsset {
  id     String    @id @default(uuid()) @db.Uuid
  caseId String    @map("case_id") @db.Uuid
  case   Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  slot   AssetSlot

  /// Публичный путь внутри сайта, например /cases/case-crm-a1b2c3d4.webp
  path   String
  /// Хэш содержимого — он же в имени файла, чтобы замена обходила кеш браузера.
  hash   String
  width  Int
  height Int
  bytes  Int

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([caseId, slot])
  @@map("case_assets")
}

// -------------------------------------------------------------------- Блог

/// Статья блога. Форма совпадает с content/blog.json ровно так же, как у
/// кейсов: панель редактирует статью здесь, публикация кладёт снапшот в
/// репозиторий, сайт остаётся статикой.
model Post {
  id     String        @id @default(uuid()) @db.Uuid
  /// Адрес /blog/<slug>/ и часть имени файла обложки. После публикации не
  /// меняется: адрес статьи уже в выдаче и в чужих ссылках.
  slug   String        @unique
  status ContentStatus @default(published)

  title           String
  /// Описание для карточки в списке блога.
  excerpt         String
  /// Рубрика: плашка на обложке и третий уровень хлебных крошек.
  category        String
  /// Вводный абзац под заголовком.
  lead            String
  metaTitle       String @map("meta_title")
  metaDescription String @map("meta_description")

  /// Публичный путь обложки: /blog/post-<slug>-<hash>.webp либо рисованный
  /// SVG первых статей. Отдельной таблицы, как у кейсов, нет — картинка одна.
  cover       String @default("")
  /// Время чтения в минутах. Панель считает по объёму, но значение правится.
  readingTime Int    @map("reading_time")

  /// Разделы статьи: [{ heading, body: string[] }]. JSON, а не две таблицы:
  /// разделы никогда не читаются отдельно от статьи, не ищутся и не
  /// переиспользуются — это её тело, а не связанные сущности.
  sections  Json
  /// Блок «Коротко» в конце. Может быть пустым.
  takeaways String[]
  /// Ключи услуг (SERVICE_PAGES), о которых статья. Связь двусторонняя: внизу
  /// статьи из них собирается блок услуг, а на странице услуги — блок статей.
  services  String[]

  /// Порядок в блоге. Обычно новые сверху, но это решает редактор.
  position Int

  /// Дата публикации (день, без времени) — показывается в карточке и уезжает
  /// в Article-разметку.
  publishedAt DateTime @map("published_at") @db.Date

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  /// Мягкое удаление: статья исчезает с сайта, но остаётся для истории.
  deletedAt DateTime? @map("deleted_at")

  @@index([status, position])
  @@map("posts")
}

/// Счётчик ревизий контента — основа оптимистичной блокировки. Панель
/// открывается на version = value и присылает её обратно; если значение
/// успело измениться, запись отклоняется.
// ------------------------------------------------------------- Каталог услуг

/// Раздел каталога услуг. Не маршрут, а кнопка фильтра на /uslugi/ — поэтому у
/// него нет ни адреса, ни текстов, только подпись и порядок. Форма совпадает с
/// `content/service-catalog.json`, так что перенос — это сид, а не переделка.
model ServiceCategory {
  key      String @id
  title    String
  position Int

  services ServiceEntry[]

  @@map("service_categories")
}

/// Услуга в каталоге: адрес страницы, раздел и признак черновика.
///
/// Тексты страницы сюда не переезжают — они остаются в `content/services.json`.
/// Здесь только структура, которую правит панель: к какому разделу услуга
/// относится, в каком порядке стоит и опубликована ли.
///
/// `key` — первичный ключ, а не uuid: на него ссылаются статьи блога, кейсы,
/// 3D-сцены героя и `Lead.service` в CRM, и он должен совпадать в пяти местах.
model ServiceEntry {
  key         String  @id
  slug        String  @unique
  categoryKey String  @map("category_key")
  /// Черновик собирается и открывается по своему адресу, но не попадает ни в
  /// каталог, ни в меню, ни в карту сайта, а страница отдаётся с noindex.
  draft       Boolean @default(false)
  position    Int

  /// Restrict, а не Cascade: удаление раздела не должно уносить с собой
  /// страницы услуг, которые в нём стояли.
  category ServiceCategory @relation(fields: [categoryKey], references: [key], onDelete: Restrict)

  @@map("service_entries")
}

model ContentRevision {
  id        Int      @id @default(autoincrement())
  scope     String   @unique
  value     Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("content_revisions")
}

// ------------------------------------------------------------------- Доступ

enum UserRole {
  owner
  editor
  /// Только раздел лидов. Заведена под маркетолога, который приводит
  /// обращения и ведёт их сам, но к проектам, задачам и сайту отношения не
  /// имеет. Ограничение проверяется на каждом маршруте, а не прячется в меню:
  /// скрытая кнопка защищает от случайности, а не от человека с консолью.
  marketing
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  /// Argon2id. Открытый пароль не хранится и не логируется.
  passwordHash String    @map("password_hash")
  name         String?
  role         UserRole  @default(editor)
  lastLoginAt  DateTime? @map("last_login_at")

  /// Куда бот шлёт личный утренний список. Пусто — уведомления не приходят,
  /// и это нормальное состояние: подключение к боту добровольное.
  telegramChatId        String?   @unique @map("telegram_chat_id")
  /// Одноразовый код привязки: CRM показывает его вошедшему пользователю, тот
  /// отправляет боту `/start <код>`. Так бот узнаёт, кто ему пишет, не спрашивая
  /// ни почту, ни пароль — в переписке с ботом им не место.
  telegramLinkCode      String?   @unique @map("telegram_link_code")
  telegramLinkExpiresAt DateTime? @map("telegram_link_expires_at")

  sessions Session[]
  actions  AuditLog[]

  ownedLeads   Lead[] @relation("LeadOwner")
  createdTasks Task[] @relation("TaskAuthor")
  notes        Note[] @relation("NoteAuthor")

  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  disabledAt DateTime? @map("disabled_at")

  @@map("users")
}

/// Серверные сессии вместо JWT: в cookie уходит только случайный секрет, в базе
/// лежит его хэш — так доступ отзывается мгновенно.
model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  ip        String?
  userAgent String?   @map("user_agent")
  createdAt DateTime  @default(now()) @map("created_at")
  revokedAt DateTime? @map("revoked_at")

  @@index([userId])
  @@map("sessions")
}

/// Кто, что и когда изменил.
model AuditLog {
  id       String  @id @default(uuid()) @db.Uuid
  userId   String? @map("user_id") @db.Uuid
  user     User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  entity   String
  entityId String? @map("entity_id")
  action   String
  diff     Json?
  ip       String?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([entity, entityId])
  @@map("audit_log")
}

// ---------------------------------------------------------------------- CRM
//
// Внутренняя система команды: лиды, клиенты, проекты, задачи. Живёт в той же
// базе, что и контент сайта, — пользователи, сессии и журнал общие, бэкап
// один. Публичных страниц не касается: сайт остаётся статикой и о таблицах
// ниже не знает.

enum LeadStatus {
  /// Пришёл, никто ещё не взял в работу.
  new
  /// Ответили, идёт переписка.
  contacted
  /// Понятно, что нужно; считаем или готовим предложение.
  qualified
  /// Превратился в проект.
  won
  /// Отказ — свой или клиента.
  lost
}

/// Обращения. Пока заводятся руками: заявки идут в мессенджеры мимо сайта.
/// Поля `source` и `channel` рассчитаны на будущую форму — когда она появится,
/// добавится только маршрут, миграция не потребуется.
model Lead {
  id String @id @default(uuid()) @db.Uuid

  name    String?
  /// Как с ним связаться: телефон, почта или ник. Одной строкой — на входе
  /// это всегда одна строка, и разбирать её всё равно никто не станет.
  contact String
  message String?
  /// Страница входа и utm-метки. Заполняет форма; при ручном заведении пусто.
  source  Json?
  /// Откуда пришёл: form | telegram | whatsapp | max | phone | email | referral.
  /// Строка, а не enum: список каналов меняется чаще, чем стоит гонять миграции.
  channel String?

  status LeadStatus @default(new)

  ownerId String? @map("owner_id") @db.Uuid
  owner   User?   @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  /// Когда следующий шаг. Просроченное значение — единственная причина, по
  /// которой лид попадает в утренний дайджест: статусы сами о себе не
  /// напоминают, и «ведём переписку» висит месяцами, пока про него не забудут.
  nextActionAt   DateTime? @map("next_action_at")
  /// Что именно за шаг: «позвонить», «отправить смету». Без него напоминание
  /// сообщает только срок, и всё равно приходится открывать карточку, чтобы
  /// вспомнить, о чём речь.
  nextActionNote String?   @map("next_action_note")
  lostReason     String?   @map("lost_reason")

  /// Ключ услуги из SERVICE_PAGES сайта — что человеку нужно. Отвечает на
  /// вопрос «какие услуги вообще приносят обращения». Строка, а не enum:
  /// список услуг живёт на сайте и меняется без участия базы.
  service String?

  clientId String? @map("client_id") @db.Uuid
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  projects Project[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([status, nextActionAt])
  @@index([createdAt])
  @@map("leads")
}

model Client {
  id       String  @id @default(uuid()) @db.Uuid
  name     String
  /// Единственный реквизит, который стоит держать отдельным полем: по нему
  /// клиент однозначно опознаётся в документах и в банке.
  inn      String?
  site     String?
  /// [{ type: "phone" | "email" | "telegram", value, label? }] — список, а не
  /// колонки: у одного клиента бывает три телефона и ни одной почты.
  contacts Json?
  notes    String?

  leads    Lead[]
  projects Project[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("clients")
}

enum ProjectStatus {
  planned
  active
  /// Ждём клиента, оплату или сторонний сервис. Отдельно от active, потому что
  /// зависший проект и идущий проект требуют разного внимания.
  on_hold
  done
  cancelled
}

model Project {
  id          String        @id @default(uuid()) @db.Uuid
  title       String
  description String?
  status      ProjectStatus @default(planned)

  clientId String? @map("client_id") @db.Uuid
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  /// Из какого обращения вырос. Нужен, чтобы был виден весь путь от первого
  /// сообщения до сданной работы.
  leadId   String? @map("lead_id") @db.Uuid
  lead     Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  /// Кто ведёт. Имена, а не ссылки на учётные записи: разработчики работают под
  /// общим входом, отдельных аккаунтов у них нет. Список — проект нередко тянут
  /// вдвоём, и в утренней сводке должно быть видно обоих.
  ///
  /// Допустимые значения проверяются по DEVELOPERS в src/crm/developers.ts:
  /// свободная строка означала бы «Вадим», «вадим» и «Вадик» как трёх разных
  /// людей, и любая группировка по имени сразу бы врала.
  developers String[]

  /// Где размещён: «наш VPS», «reg.ru у клиента», «Timeweb». Свободная строка —
  /// хостингов столько же, сколько клиентов, и списком их не закрыть.
  hosting  String?
  /// Вид работы: договорной, разовый, сопровождение. Строкой, а не enum: набор
  /// уточняется по ходу, а миграция ради нового варианта — перебор.
  workType String? @map("work_type")

  contractNumber String?   @map("contract_number")
  contractDate   DateTime? @map("contract_date")
  /// Дата акта выполненных работ по проекту в целом. Помесячные акты живут
  /// отдельными записями в invoices.
  actDate        DateTime? @map("act_date")

  /// Счета выставляются каждый месяц. Признак нужен, чтобы бот напоминал про
  /// период, за который счёта ещё нет, — в этом и весь смысл учёта.
  billingMonthly     Boolean  @default(false) @map("billing_monthly")
  /// Ожидаемая сумма в месяц — в минорных единицах: копейках или центах.
  ///
  /// Целое, а не дробное: 0.1 + 0.2 в двоичной дроби не равно 0.3, и на суммах
  /// это однажды вылезает расхождением в копейку. Decimal решил бы то же, но
  /// притащил бы отдельный тип на все слои, включая JSON.
  ///
  /// Суффикс в имени не для красоты: без него пропущенное при правке место
  /// покажет сумму в сто раз больше и никак об этом не скажет.
  monthlyAmountMinor Int?     @map("monthly_amount_minor")
  /// Валюта monthlyAmount и счетов проекта по умолчанию.
  currency           Currency @default(rub)

  invoices    Invoice[]
  credentials Credential[]

  /// Порядок внутри колонки на доске.
  position Int @default(0)

  startedAt DateTime? @map("started_at")
  deadline  DateTime?
  closedAt  DateTime? @map("closed_at")

  /// Кейс на сайте, в который превратился проект. Связь ставится в момент
  /// публикации; удаление кейса обнуляет её, но не трогает сам проект.
  caseId String? @unique @map("case_id") @db.Uuid
  case   Case?   @relation(fields: [caseId], references: [id], onDelete: SetNull)

  tasks Task[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([status, deadline])
  @@map("projects")
}

/**
 * Валюта суммы. Хранится рядом с каждой суммой, а не одна на всю систему:
 * часть работ считается в долларах, и общий признак заставлял бы переводить
 * по курсу — то есть придумывать число, которого никто не называл.
 * По той же причине суммы в разных валютах нигде не складываются: итоги
 * считаются отдельно по каждой.
 */
enum Currency {
  rub
  usd
}

enum InvoiceKind {
  /// Счёт на оплату.
  invoice
  /// Акт выполненных работ.
  act
}

/// Счета и акты по проекту, по одному на период.
///
/// Отдельная запись, а не поле проекта: счета выставляются каждый месяц, и
/// «дата счёта» одним полем затирала бы прошлый месяц. Здесь же видно, за
/// какой период выставлено, что оплачено и чего ещё нет.
///
/// Документы CRM не рисует — только помнит. Генерация требует нумерации,
/// реквизитов и НДС, а болит не она: болит «за апрель выставить забыли».
model Invoice {
  id        String      @id @default(uuid()) @db.Uuid
  projectId String      @map("project_id") @db.Uuid
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind      InvoiceKind

  /// Период в виде ГГГГ-ММ. Строкой, потому что это календарный месяц, а не
  /// момент времени: сравнивать и сортировать так же просто, а часовые пояса
  /// не превращают март в февраль.
  period      String
  /// В минорных единицах, как и monthlyAmountMinor у проекта. Валюта — рядом.
  amountMinor Int?     @map("amount_minor")
  currency    Currency @default(rub)

  issuedAt DateTime? @map("issued_at")
  paidAt   DateTime? @map("paid_at")
  note     String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// Один счёт и один акт на период: два счёта за март — это ошибка ввода.
  @@unique([projectId, kind, period])
  @@index([period])
  @@map("invoices")
}

enum TaskStatus {
  backlog
  todo
  in_progress
  done
  cancelled
}

enum TaskPriority {
  low
  normal
  high
}

model Task {
  id          String  @id @default(uuid()) @db.Uuid
  title       String
  description String?

  /// Необязателен намеренно: половина настоящих задач ни к какому проекту не
  /// относится — «продлить домен», «выставить счёт», «ответить в налоговую».
  projectId String?  @map("project_id") @db.Uuid
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  status   TaskStatus   @default(todo)
  priority TaskPriority @default(normal)
  /// Порядок внутри колонки на доске.
  position Int          @default(0)

  /// Кто делает. Имена из DEVELOPERS, как и у проекта, — по той же причине.
  developers  String[]
  createdById String?  @map("created_by_id") @db.Uuid
  createdBy   User?    @relation("TaskAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  dueAt       DateTime? @map("due_at")
  completedAt DateTime? @map("completed_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([status, position])
  @@index([dueAt])
  @@map("tasks")
}

/// Учётки сервисов, которыми пользуется команда.
///
/// **Паролей здесь нет и быть не должно.** Это справочник «что у нас вообще
/// есть и на кого записано»: сервис, логин, адрес, на какой почте, когда
/// продлевать. Пароли живут в менеджере паролей — база регулярно уезжает в
/// дампы, и одна утечка дампа отдала бы разом все сервисы.
///
/// Поле `secretHint` — не пароль, а подсказка, где его искать: «Bitwarden,
/// папка Хостинг».
model Credential {
  id          String    @id @default(uuid()) @db.Uuid
  /// Название сервиса: reg.ru, Яндекс 360, GitHub.
  service     String
  /// Логин или адрес почты, под которым заходят.
  login       String?
  url         String?
  /// На кого оформлено — имя из DEVELOPERS или название компании.
  owner       String?
  /// К какому проекту относится доступ. Пусто — общий: почта, GitHub, хостинг.
  ///
  /// SetNull, а не Cascade: закрытый проект не должен уносить с собой пароль от
  /// хостинга, на котором его сайт продолжает работать.
  projectId   String?   @map("project_id") @db.Uuid
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  /// Где лежит пароль, если он не здесь: «Bitwarden, папка Хостинг».
  secretHint  String?   @map("secret_hint")
  /// Сам пароль — **зашифрованный в браузере**, base64 от `iv || ciphertext`.
  ///
  /// Сервер это только хранит и отдаёт: ключ выводится из мастер-фразы на
  /// устройстве и сюда никогда не попадает. Поэтому утечка дампа отдаёт
  /// нечитаемый мусор, а не все сервисы разом, — ровно из-за этого пароли
  /// раньше здесь не хранились вовсе.
  secret      String?   @db.Text
  /// Когда продлевать: домены, сертификаты, платные подписки.
  renewsAt    DateTime? @map("renews_at")
  /// Сколько стоит, в минорных единицах — как у проекта.
  amountMinor Int?      @map("amount_minor")
  currency    Currency  @default(rub)
  /// Списывается каждый месяц. Без признака сумма непонятна: 500 ₽ у хостинга
  /// и 500 ₽ у домена — это про разные деньги в год.
  monthlyFee  Boolean   @default(false) @map("monthly_fee")
  notes       String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([service])
  @@index([projectId])
  @@map("credentials")
}

/// Отметки планировщика: «эта рассылка за такое-то число уже ушла».
///
/// Именно в базе, а не в памяти процесса: иначе перезапуск сервиса днём решит,
/// что дайджеста сегодня ещё не было, и разошлёт его повторно — а при пяти
/// перезапусках пять раз. Дата хранится строкой ГГГГ-ММ-ДД в часовом поясе
/// команды: сравнивать надо календарные сутки, а не моменты времени.
/// Параметры хранилища паролей. Строка ровно одна: ключ у команды общий.
model VaultSetting {
  id String @id @default("vault")

  /// Соль для вывода ключа из мастер-фразы. Не секрет, но менять её нельзя —
  /// с другой солью тот же пароль даёт другой ключ, и всё станет нечитаемым.
  salt     String
  /// Контрольное значение, зашифрованное тем же ключом. Расшифровалось —
  /// фраза верна. Иначе проверить правильность ввода нечем: сервер не знает
  /// ни фразы, ни ключа.
  verifier String

  createdAt DateTime @default(now()) @map("created_at")

  @@map("vault_settings")
}

model JobRun {
  job   String   @id
  ranOn String   @map("ran_on")
  ranAt DateTime @updatedAt @map("ran_at")

  @@map("job_runs")
}

/// Комментарии сразу ко всему: лид, клиент, проект, задача. Одна таблица
/// вместо четырёх — на троих отдельные comment-таблицы дают лишние джойны и
/// ноль пользы. Внешнего ключа нет намеренно: он не бывает полиморфным.
model Note {
  id       String @id @default(uuid()) @db.Uuid
  /// lead | client | project | task
  entity   String
  entityId String @map("entity_id") @db.Uuid
  body     String

  authorId String? @map("author_id") @db.Uuid
  author   User?   @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([entity, entityId, createdAt])
  @@map("notes")
}
