// Схема базы сайта it-optimization.ru. См. docs/backend.md.
// Форма таблицы `cases` намеренно совпадает с content/cases.json, поэтому
// перенос данных — это сид, а не переделка модели.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- Портфолио

enum ContentStatus {
  draft
  published
}

model Case {
  id     String        @id @default(uuid()) @db.Uuid
  /// Участвует в именах файлов и в ссылках со страниц услуг, поэтому живёт
  /// отдельно от id и переживает переименование заголовка.
  slug   String        @unique
  status ContentStatus @default(published)

  title       String
  description String
  quote       String
  /// Раньше было одной строкой «A · B · C»; массив — нормальная форма.
  tags        String[]

  /// Порядок на сайте. Первые HOME_CASE_COUNT попадают на главную.
  position Int

  assets CaseAsset[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  /// Мягкое удаление: кейс исчезает с сайта, но остаётся для истории.
  deletedAt DateTime? @map("deleted_at")

  @@index([status, position])
  @@map("cases")
}

enum AssetSlot {
  cover
  detail
  detail_mobile
}

/// Картинки кейса. Отдельной таблицей: ассет переживает смену slug, а по хэшу
/// видно, что перезаливать его не нужно.
model CaseAsset {
  id     String    @id @default(uuid()) @db.Uuid
  caseId String    @map("case_id") @db.Uuid
  case   Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  slot   AssetSlot

  /// Публичный путь внутри сайта, например /cases/case-crm-a1b2c3d4.webp
  path   String
  /// Хэш содержимого — он же в имени файла, чтобы замена обходила кеш браузера.
  hash   String
  width  Int
  height Int
  bytes  Int

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([caseId, slot])
  @@map("case_assets")
}

/// Счётчик ревизий контента — основа оптимистичной блокировки. Панель
/// открывается на version = value и присылает её обратно; если значение
/// успело измениться, запись отклоняется.
model ContentRevision {
  id        Int      @id @default(autoincrement())
  scope     String   @unique
  value     Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("content_revisions")
}

// ------------------------------------------------------------------- Доступ

enum UserRole {
  owner
  editor
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  /// Argon2id. Открытый пароль не хранится и не логируется.
  passwordHash String    @map("password_hash")
  name         String?
  role         UserRole  @default(editor)
  lastLoginAt  DateTime? @map("last_login_at")

  sessions Session[]
  actions  AuditLog[]

  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  disabledAt DateTime? @map("disabled_at")

  @@map("users")
}

/// Серверные сессии вместо JWT: в cookie уходит только случайный секрет, в базе
/// лежит его хэш — так доступ отзывается мгновенно.
model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  ip        String?
  userAgent String?   @map("user_agent")
  createdAt DateTime  @default(now()) @map("created_at")
  revokedAt DateTime? @map("revoked_at")

  @@index([userId])
  @@map("sessions")
}

/// Кто, что и когда изменил.
model AuditLog {
  id       String  @id @default(uuid()) @db.Uuid
  userId   String? @map("user_id") @db.Uuid
  user     User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  entity   String
  entityId String? @map("entity_id")
  action   String
  diff     Json?
  ip       String?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([entity, entityId])
  @@map("audit_log")
}

// ------------------------------------------------------ Заготовка под формы

/// Сейчас заявки идут прямо в мессенджеры мимо сайта. Когда на сайте появится
/// форма, ей понадобится эта таблица — вместе с требованиями 152-ФЗ к хранению
/// персональных данных и согласию на обработку.
model Lead {
  id        String   @id @default(uuid()) @db.Uuid
  name      String?
  contact   String
  message   String?
  /// Откуда пришёл: страница, utm-метки.
  source    Json?
  processed Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("leads")
}
