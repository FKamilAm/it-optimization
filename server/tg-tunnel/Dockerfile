# Выход в Telegram через сервер Вадима.
#
# Из сети нашего хостера до адресов api.telegram.org нет маршрута — не отвечают
# ни 443, ни 80, ни 8443, это блокировка на уровне адресов, и изнутри сервера
# она не обходится. Сервер Вадима до телеграма достаёт, поэтому соединение
# идёт через него обычным SSH-пробросом порта.
#
# Туннель — отдельный контейнер, а не служба на хосте, потому что бот живёт
# внутри контейнера API: 127.0.0.1 там — это сам контейнер, и туннель на хосте
# он бы не увидел.
FROM alpine:3.20

RUN apk add --no-cache openssh-client autossh

COPY ssh_config /etc/ssh/tg_config

# Без этого autossh сдаётся, если первое же соединение не удалось: по
# умолчанию выход ssh в первые 30 секунд считается фатальным. Для туннеля,
# который стартует раньше, чем поднимется сеть, это верная смерть.
ENV AUTOSSH_GATETIME=0

# Проброс, а не SOCKS. Бот ходит на https://api.telegram.org стандартным fetch,
# а он SOCKS не умеет; зато имя api.telegram.org внутри сети compose указывает
# на этот контейнер (см. aliases в docker-compose.prod.yml). Бот открывает
# обычное TLS-соединение, мы передаём его байты дальше, а имя назначения
# разрешает уже сервер Вадима. TLS целиком между ботом и телеграмом:
# ни мы, ни Вадим не видим ни токена, ни содержимого.
CMD ["autossh", "-M", "0", "-N", "-F", "/etc/ssh/tg_config", \
     "-L", "0.0.0.0:443:api.telegram.org:443", "it-opt-proxy"]
