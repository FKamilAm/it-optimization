# Скопировать в server/.env и заполнить. В репозиторий .env не коммитится.

# --- База -------------------------------------------------------------------
# Локально поднимается docker compose (см. server/docker-compose.yml).
DATABASE_URL=postgresql://itopt:itopt@localhost:5433/itopt?schema=public

# --- Сервис -----------------------------------------------------------------
PORT=4000
NODE_ENV=development

# Кому разрешён доступ к API (CORS + куки): сайт и CRM, через запятую.
# В проде: https://it-optimization.ru,https://crm.it-optimization.ru
WEB_ORIGIN=http://localhost:3000,http://localhost:5173

# Secure-флаг на сессионной куке. В проде обязательно true (нужен HTTPS).
COOKIE_SECURE=false
# Домен куки. В проде — .it-optimization.ru, если API живёт на поддомене.
COOKIE_DOMAIN=
# Срок жизни сессии в днях.
SESSION_TTL_DAYS=14

# --- Файлы ------------------------------------------------------------------
# Куда складываются обработанные картинки кейсов.
UPLOAD_DIR=./uploads
# Максимальный размер загружаемого файла, байты (по умолчанию 15 МБ).
MAX_UPLOAD_BYTES=15728640

# --- Напоминания в телеграме ------------------------------------------------
# Токен от @BotFather. Не задан — бот не запускается, всё остальное работает.
# В репозиторий не коммитится: .env закрыт gitignore.
TELEGRAM_BOT_TOKEN=
# Общий чат для сообщений о новых лидах (у групп id отрицательный, с -100).
# Пусто — сообщения уходят всем, кто подключил бота лично.
TELEGRAM_TEAM_CHAT_ID=
# Во сколько уходит утренний список, ЧЧ:ММ.
DIGEST_TIME=09:00
# Пояс, в котором считаются «сегодня» и «просрочено».
TIMEZONE=Europe/Moscow

# --- Публикация -------------------------------------------------------------
# Публикация коммитит снапшот content/cases.json и картинки в репозиторий,
# GitHub Actions пересобирает статику и заливает её на хостинг.
# Без этих переменных публикация работает в «сухом» режиме: снапшот отдаётся,
# но никуда не уезжает — удобно для локальной разработки.
GITHUB_TOKEN=
GITHUB_OWNER=FKamilAm
GITHUB_REPO=it-optimization
GITHUB_BRANCH=main
