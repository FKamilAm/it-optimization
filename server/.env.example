# Скопировать в server/.env и заполнить. В репозиторий .env не коммитится.

# --- База -------------------------------------------------------------------
# Локально поднимается docker compose (см. server/docker-compose.yml).
DATABASE_URL=postgresql://itopt:itopt@localhost:5433/itopt?schema=public

# --- Сервис -----------------------------------------------------------------
PORT=4000
NODE_ENV=development

# Домен сайта, которому разрешён доступ к API (CORS + куки).
# В проде: https://it-optimization.ru
WEB_ORIGIN=http://localhost:3000

# Secure-флаг на сессионной куке. В проде обязательно true (нужен HTTPS).
COOKIE_SECURE=false
# Домен куки. В проде — .it-optimization.ru, если API живёт на поддомене.
COOKIE_DOMAIN=
# Срок жизни сессии в днях.
SESSION_TTL_DAYS=14

# --- Файлы ------------------------------------------------------------------
# Куда складываются обработанные картинки кейсов.
UPLOAD_DIR=./uploads
# Максимальный размер загружаемого файла, байты (по умолчанию 15 МБ).
MAX_UPLOAD_BYTES=15728640

# --- Публикация -------------------------------------------------------------
# Публикация коммитит снапшот content/cases.json и картинки в репозиторий,
# GitHub Actions пересобирает статику и заливает её на хостинг.
# Без этих переменных публикация работает в «сухом» режиме: снапшот отдаётся,
# но никуда не уезжает — удобно для локальной разработки.
GITHUB_TOKEN=
GITHUB_OWNER=FKamilAm
GITHUB_REPO=it-optimization
GITHUB_BRANCH=main
