# Copy this file to `.env.local` and adjust values for local development.

# Public site URL (used for SEO metadata / canonical).
NEXT_PUBLIC_SITE_URL=https://it-optimization.ru

# Contact channels shown on the site.
NEXT_PUBLIC_CONTACT_EMAIL=info@itoptimizations.ru
NEXT_PUBLIC_CONTACT_PHONE=+79937266061
NEXT_PUBLIC_TELEGRAM_URL=https://t.me/dujaii
NEXT_PUBLIC_WHATSAPP_URL=https://wa.me/79963266161
# MAX has no phone-based chat links — point this at a MAX profile/bot link.
NEXT_PUBLIC_MAX_URL=https://max.ru/

# --- Панель /admin ----------------------------------------------------------
# Адрес API из server/. Если задан — панель работает через собственный бэкенд:
# вход по почте и паролю, кейсы в PostgreSQL. Если не задан — старый режим с
# личным токеном GitHub. См. docs/backend.md.
# Локально: http://localhost:4000
# NEXT_PUBLIC_ADMIN_API_URL=

# Репозиторий, в который панель коммитит кейсы в режиме без бэкенда.
# Значения по умолчанию в src/lib/admin/github.ts уже указывают на нужный репо.
# NEXT_PUBLIC_ADMIN_REPO_OWNER=FKamilAm
# NEXT_PUBLIC_ADMIN_REPO_NAME=it-optimization
# NEXT_PUBLIC_ADMIN_REPO_BRANCH=main
